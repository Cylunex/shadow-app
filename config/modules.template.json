{
  "schemaVersion": 3,
  "platform": {
    "catalogVersion": 1,
    "identityIssuer": @IDENTITY_ISSUER@
  },
  "modules": [
    {
      "id": "health",
      "name": "健康",
      "description": "健康记录、趋势与设备同步",
      "canonical_url": @HEALTH_CANONICAL_URL@,
      "aliases": [
        @HEALTH_ALIAS_URL@
      ],
      "auth": {
        "mode": "forward-auth",
        "groups": ["health-users"]
      },
      "health_path": "/healthz",
      "icon": "heart",
      "color": "#14b8a6",
      "enabled": true,
      "capabilities": ["web", "health.scale", "health.samsung", "notification"]
    },
    {
      "id": "stock",
      "name": "股票",
      "description": "选股、持仓与市场研究",
      "canonical_url": @STOCK_CANONICAL_URL@,
      "aliases": [
        @STOCK_ALIAS_URL@
      ],
      "auth": {
        "mode": "oidc",
        "groups": ["stock-users"]
      },
      "health_path": "/healthz",
      "icon": "chart",
      "color": "#f59e0b",
      "enabled": true,
      "capabilities": ["web"]
    }
  ]
}
