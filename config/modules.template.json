{
  "schemaVersion": 3,
  "platform": {
    "catalogVersion": 1,
    "identityIssuer": @IDENTITY_ISSUER@
  },
  "modules": [
    {
      "id": "nexus",
      "name": "Nexus",
      "description": "统一对话、采集、搜索与审核工作台",
      "canonical_url": @NEXUS_CANONICAL_URL@,
      "aliases": @NEXUS_ALIASES@,
      "auth": {
        "mode": "forward-auth",
        "groups": ["shadow-users"]
      },
      "health_path": "/healthz",
      "icon": "app",
      "color": "#64748b",
      "enabled": true,
      "capabilities": ["web", "media"]
    },
    {
      "id": "garden",
      "name": "花园",
      "description": "内容创作、发布与个人数字花园",
      "canonical_url": @GARDEN_CANONICAL_URL@,
      "aliases": @GARDEN_ALIASES@,
      "auth": {
        "mode": "oidc",
        "groups": ["garden-admins"]
      },
      "health_path": "/healthz",
      "icon": "garden",
      "color": "#84cc16",
      "enabled": true,
      "capabilities": ["web"]
    },
    {
      "id": "health",
      "name": "健康",
      "description": "健康记录、趋势与设备同步",
      "canonical_url": @HEALTH_CANONICAL_URL@,
      "aliases": @HEALTH_ALIASES@,
      "auth": {
        "mode": "oidc",
        "groups": ["health-users"]
      },
      "health_path": "/healthz",
      "icon": "health",
      "color": "#14b8a6",
      "enabled": true,
      "capabilities": ["web", "health.scale", "health.samsung", "notification"]
    },
    {
      "id": "stock",
      "name": "股票",
      "description": "选股、持仓与市场研究",
      "canonical_url": @STOCK_CANONICAL_URL@,
      "aliases": @STOCK_ALIASES@,
      "auth": {
        "mode": "oidc",
        "groups": ["stock-users"]
      },
      "health_path": "/healthz",
      "icon": "stock",
      "color": "#f59e0b",
      "enabled": true,
      "capabilities": ["web"]
    },
    {
      "id": "travel",
      "name": "足迹",
      "description": "地点、到访、主题地图与旅行记录",
      "canonical_url": @TRAVEL_CANONICAL_URL@,
      "aliases": @TRAVEL_ALIASES@,
      "auth": {
        "mode": "oidc",
        "groups": ["travel-users"]
      },
      "health_path": "/healthz",
      "icon": "travel",
      "color": "#38bdf8",
      "enabled": true,
      "capabilities": ["web", "map", "media"]
    },
    {
      "id": "ledger",
      "name": "账簿",
      "description": "消费记录、金额事实与未来计划",
      "canonical_url": @LEDGER_CANONICAL_URL@,
      "aliases": @LEDGER_ALIASES@,
      "auth": {
        "mode": "oidc",
        "groups": ["ledger-users"]
      },
      "health_path": "/healthz",
      "icon": "ledger",
      "color": "#fb7185",
      "enabled": true,
      "capabilities": ["web", "finance", "media"]
    },
    {
      "id": "notifications",
      "name": "收件箱",
      "description": "跨项目通知、投递状态与平台运维",
      "canonical_url": @NOTIFICATIONS_CANONICAL_URL@,
      "aliases": @NOTIFICATIONS_ALIASES@,
      "auth": {
        "mode": "oidc",
        "groups": ["shadow-users"]
      },
      "health_path": "/healthz",
      "icon": "platform",
      "color": "#a78bfa",
      "enabled": @NOTIFICATIONS_ENABLED@,
      "capabilities": ["web", "inbox", "operations"]
    }
  ]
}
