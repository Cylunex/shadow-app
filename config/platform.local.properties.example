# Copy this file to platform.local.properties and replace every example value.
# The local file is ignored by Git. Values may alternatively be supplied through
# matching SHADOW_<MODULE>_* environment variables.
# 推荐：直接使用 shadow-platform 编译生成的 schemaVersion 4 投影。
# platform.runtimeFile=/absolute/path/to/shadow-app-runtime.json
# SHADOW_APP_RUNTIME_FILE 可提供同一值。
# 以下逐模块字段仅作为旧版本地开发兼容入口。
platform.identityIssuer=https://auth.example.com
nexus.canonicalUrl=https://nexus.example.com/
nexus.aliasUrl=https://nas.example.com/harness/
garden.canonicalUrl=https://example.com/
garden.aliasUrl=
health.canonicalUrl=https://health.example.com/
health.aliasUrl=http://nas.example.com:8080/health/
stock.canonicalUrl=https://stock.example.com/
stock.aliasUrl=http://nas.example.com:8080/stock/
travel.canonicalUrl=https://example.com/travel/
travel.aliasUrl=https://travel.example.com/
ledger.canonicalUrl=https://ledger.example.com/
ledger.aliasUrl=
notifications.canonicalUrl=https://notify.example.com/
notifications.aliasUrl=
notifications.enabled=false
