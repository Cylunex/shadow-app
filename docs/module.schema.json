{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cylunex/shadow-app/docs/module.schema.json",
  "title": "Shadow App Platform Catalog projection",
  "type": "object",
  "required": ["schemaVersion", "platform", "modules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 3 },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogVersion", "identityIssuer"],
      "properties": {
        "catalogVersion": { "const": 1 },
        "identityIssuer": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "canonical_url", "aliases", "auth", "health_path",
        "icon", "color", "enabled", "capabilities"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 24 },
        "description": { "type": "string", "maxLength": 80 },
        "canonical_url": { "$ref": "#/$defs/httpsUrl" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/url" }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "groups"],
          "properties": {
            "mode": {
              "enum": [
                "public", "public-with-protected-paths", "forward-auth", "oidc",
                "service-bearer"
              ]
            },
            "groups": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
            }
          }
        },
        "health_path": {
          "anyOf": [
            { "type": "string", "pattern": "^/" },
            { "type": "null" }
          ]
        },
        "icon": {
          "enum": [
            "app", "archive", "garden", "health", "ledger",
            "platform", "stock", "travel", "verse", "wingman"
          ]
        },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "enabled": { "type": "boolean" },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "web", "health.scale", "health.samsung", "notification",
              "map", "media", "finance", "inbox", "operations"
            ]
          }
        }
      }
    }
  }
}
