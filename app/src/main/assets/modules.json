{
  "schemaVersion": 2,
  "modules": [
    {
      "id": "health",
      "name": "健康",
      "description": "健康记录、趋势与设备同步",
      "routes": [
        {
          "server": "nas",
          "port": 55080,
          "startPath": "/shealth/",
          "probePath": "/shealth/healthz"
        },
        {
          "server": "cloud",
          "port": 20001,
          "startPath": "/shealth/",
          "probePath": "/shealth/healthz"
        }
      ],
      "icon": "heart",
      "color": "#14b8a6",
      "enabled": true,
      "capabilities": ["web", "health.scale", "health.samsung", "notification"]
    },
    {
      "id": "stock",
      "name": "股票",
      "description": "选股、持仓与市场研究",
      "routes": [
        {
          "server": "nas",
          "port": 55080,
          "startPath": "/stock/",
          "probePath": "/stock/api/health"
        },
        {
          "server": "cloud",
          "port": 20001,
          "startPath": "/stock/",
          "probePath": "/stock/api/health"
        }
      ],
      "icon": "chart",
      "color": "#f59e0b",
      "enabled": true,
      "capabilities": ["web"]
    }
  ]
}
