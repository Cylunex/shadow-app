<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="shell.xml" />
        <exclude domain="sharedpref" path="nexus_native.xml" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Keystore keys do not transfer reliably; never move their encrypted queue. -->
        <exclude domain="sharedpref" path="shell.xml" />
        <exclude domain="sharedpref" path="nexus_native.xml" />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
